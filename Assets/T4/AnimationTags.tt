<#@ template debug="false" hostspecific="true" language="C#v3.5" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ output extension=".cs" #>
<# 
	var tags = ParseTags(System.IO.File.ReadAllText(this.Host.ResolvePath("./data/AnimationTags.csv")));
#>
using System.Collections.Generic;

public static class AnimationTags
{
<#
int lastFrame = 0;
foreach(var tag in tags)
{
	lastFrame = tag.to;
#>
	public static AnimationTag <#=tag.name#> = new AnimationTag(AnimationTagType.<#=tag.name#>, <#=tag.from#>, <#=tag.to#>);
<# } #>

	public const int totalFrameCount = <#=lastFrame + 1#>;
	public static AnimationTag[] tagsArray = new AnimationTag[] {
<# 
foreach(var tag in tags)
{
#>
		<#=tag.name#>,
<#}#>
	};

	public static Dictionary<AnimationTagType, AnimationTag> tags = new Dictionary<AnimationTagType, AnimationTag>() {
<# 
foreach(var tag in tags)
{
#>
		{ AnimationTagType.<#=tag.name#>, <#=tag.name#> },
<#}#>
	};
}

public struct AnimationTag
{
	public AnimationTagType tagType;
	public int frameFrom;
	public int frameTo;
	public int[] frames;
	public int frameCount;

	public AnimationTag(AnimationTagType tagType, int frameFrom, int frameTo)
	{
		this.tagType = tagType;
		this.frameFrom = frameFrom;
		this.frameTo = frameTo;
		this.frameCount = frameTo - frameFrom + 1;
		this.frames = new int[this.frameCount];
		int index = 0;
		for (int f = frameFrom; f <= frameTo; f++)
		{
			this.frames[index++] = f;
		}
	}
}

public enum AnimationTagType
{
<# 
foreach(var tag in tags)
{
#>
	<#=tag.name#>,
<#}#>
}
<#+ 
private List<TagDefinition> ParseTags(string content)
{
	var tags = new List<TagDefinition>();
	var lines = Array.ConvertAll(content.Split(new[] {'\r', '\n'}, StringSplitOptions.RemoveEmptyEntries), l => l.Trim());
	
	foreach(var line in lines)
	{
		if (line.StartsWith("#"))
		{
			continue;
		}
		string[] tokens = line.Split(',');
		tags.Add(new TagDefinition(UnderscoreToCamelCase(tokens[0]), int.Parse(tokens[1]), int.Parse(tokens[2])));
	}
	return tags;
}

private string UnderscoreToCamelCase(string name)
{
	string[] array = name.Split('_', '-');
	for (int i = 0; i < array.Length; i++)
	{
		string s = array[i];
		string first = string.Empty;
		string rest = string.Empty;
		if (s.Length > 0)
		{
			first = Char.ToUpperInvariant(s[0]).ToString();
		}
		if (s.Length > 1)
		{
			rest = s.Substring(1).ToLowerInvariant();
		}
		array[i] = first + rest;
	}
	return string.Join("", array);
}

private class TagDefinition
{
	public readonly string name;
	public readonly int from;
	public readonly int to;

	public TagDefinition(string name, int from, int to)
	{
		this.name = name;
		this.from = from;
		this.to = to;
	}
}
#>