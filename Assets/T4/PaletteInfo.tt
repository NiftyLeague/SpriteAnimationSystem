<#@ template debug="false" hostspecific="true" language="C#v3.5" #>
<#@ import namespace="System.Collections.Generic" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Net" #>
<#@ output extension=".cs" #>
<# 
	var palette = ParsePaletteInformation(System.IO.File.ReadAllText(this.Host.ResolvePath("./data/PaletteInfo.csv")));
#>
using UnityEngine;
using System.Collections.Generic;

public static class PaletteInfo
{
	public const int numColors = <#=palette.Count#>;

<#
Dictionary<int, int> indexMap = new Dictionary<int, int>();
foreach(var c in palette)
{
	indexMap.Add(c.swapIndex, c.index);
    var cs = c.colorRGB.Split('-');
#>
	public static PaletteColor paletteColor<#=c.index#> = new PaletteColor(<#=c.index#>, PaletteSwapIndex.Swap<#=c.index#>_<#=c.name#>, new Color32(<#=cs[0]#>, <#=cs[1]#>, <#=cs[2]#>, 255), "<#=c.displayName#>");
<#}#>

	public static PaletteColor[] paletteColors = new PaletteColor[] {
<# 
foreach(var c in palette)
{
#>
		paletteColor<#=c.index#>,
<#}#>
	};

	public static Color32[] colors = new Color32[] {
<# 
foreach(var c in palette)
{
    var cs = c.colorRGB.Split('-');
#>
		new Color32(<#=cs[0]#>, <#=cs[1]#>, <#=cs[2]#>, 255),
<#}#>
	};

	public static Dictionary<int, PaletteColor> indexMap = new Dictionary<int, PaletteColor> {
<# 
foreach(var pair in indexMap.OrderBy(c => c.Key))
{
#>
		{ <#=pair.Key#>, paletteColor<#=pair.Value#> },
<#}#>
	};

	public static Dictionary<string, PaletteColor> nameMap = new Dictionary<string, PaletteColor> {
<# 
foreach(var c in palette.OrderBy(c=>c.name))
{
#>
		{ "<#=c.displayName#>", paletteColor<#=c.index#> },
<#}#>
	};

	public static Dictionary<Color32, PaletteColor> colorMap = new Dictionary<Color32, PaletteColor> {
<# 
foreach(var c in palette)
{
	var cs = c.colorRGB.Split('-');
#>
		{ new Color32(<#=cs[0]#>, <#=cs[1]#>, <#=cs[2]#>, 255), paletteColor<#=c.index#> },
<#}#>
	};
}

[System.Serializable]
public struct PaletteColor
{
	public int index;
	public PaletteSwapIndex swapIndex;
	public Color32 color;
	public string name;

	public PaletteColor(int index, PaletteSwapIndex swapIndex, Color32 color, string name)
	{
		this.index = index;
		this.swapIndex = swapIndex;
		this.color = color;
		this.name = name;
	}
}

public enum PaletteSwapIndex
{
<#
foreach(var c in palette)
{
#>
	Swap<#=c.index#>_<#=c.name#> = <#=c.swapIndex#>,
<#}#>
}
<#+
private List<PaletteColorDefinition> ParsePaletteInformation(string content)
{
	var palette = new List<PaletteColorDefinition>();
	var lines = Array.ConvertAll(content.Split(new[] {'\r', '\n'}, StringSplitOptions.RemoveEmptyEntries), l => l.Trim());
	
	foreach(var line in lines)
	{
		if (line.StartsWith("#"))
		{
			continue;
		}
		string[] tokens = line.Split(',');
		palette.Add(new PaletteColorDefinition(int.Parse(tokens[0]), int.Parse(tokens[1]), tokens[2].Substring(2), tokens[3]));
	}
    return palette;
}

private class PaletteColorDefinition
{
	public readonly int index;
	public readonly int swapIndex;
	public readonly string name;
	public readonly string displayName;
	public readonly string colorHex;
	public readonly string colorRGB;

	public PaletteColorDefinition(int index, int swapIndex, string colorHex, string colorRGB)
	{
		this.index = index;
		this.swapIndex = swapIndex;
		this.colorHex = colorHex;
		this.colorRGB = colorRGB;
		using (WebClient client = new WebClient())
		{
			string s = client.DownloadString($"https://api.color.pizza/v1/{colorHex}");
			string startString = "\"name\":\"";
			s = s.Substring(s.IndexOf(startString) + startString.Length);
			this.displayName = s.Substring(0, s.IndexOf('"')).Replace("White as Heaven", "White").Replace("Paradise of Greenery", "Greenery");
			this.name = this.displayName.Replace(" ", string.Empty);
		}
	}
}
#>
